# Resend API key used to send contact-form emails
RESEND_API_KEY=

# Destination email address for contact-form submissions
CONTACT_EMAIL=

# GitHub token used by the GitHub dashboard and DSA repository sync
GITHUB_TOKEN=

# PostgreSQL connection URL used by Prisma
DATABASE_URL=

# GitHub OAuth application client ID used by NextAuth
GITHUB_ID=

# GitHub OAuth application client secret used by NextAuth
GITHUB_SECRET=

# Secret used by NextAuth to sign and encrypt sessions
NEXTAUTH_SECRET=

# Canonical application URL used by NextAuth callbacks
NEXTAUTH_URL=

# Email address whose authenticated account receives admin privileges
ADMIN_EMAIL=

# Repository to sync for DSA content, in owner/repo format
DSA_GITHUB_REPO=

# Secret used to verify GitHub DSA webhook signatures
DSA_WEBHOOK_SECRET=

# Public canonical site URL used by RSS and sitemap metadata
NEXT_PUBLIC_SITE_URL=

# Runtime environment; normally supplied by the hosting platform
NODE_ENV=
