generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model Account {
  id                       String  @id @default(cuid())
  userId                   String
  type                     String
  provider                 String
  providerAccountId        String
  refresh_token            String?
  access_token             String?
  expires_at               Int?
  token_type               String?
  scope                    String?
  id_token                 String?
  session_state            String?
  refresh_token_expires_in Int?
  user                     User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model User {
  id            String      @id @default(cuid())
  name          String?
  email         String?     @unique
  emailVerified DateTime?
  image         String?
  accounts      Account[]
  posts         Post[]
  sessions      Session[]
  submissions   Submission[]
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model Post {
  id                  String     @id @default(cuid())
  authorId            String
  title               String
  slug                String     @unique
  content             String
  status              PostStatus @default(PENDING)
  createdAt           DateTime   @default(now())
  updatedAt           DateTime   @updatedAt
  publishedAt         DateTime?
  deletionRequestedAt DateTime?
  deletionReason      String?
  author              User       @relation(fields: [authorId], references: [id], onDelete: Cascade)
}

enum PostStatus {
  PENDING
  APPROVED
  REJECTED
}

enum SubmissionKind {
  RUN
  SUBMIT
}

enum SubmissionStatus {
  QUEUED
  RUNNING
  DONE
  FAILED
}

enum SubmissionVerdict {
  ACCEPTED
  WRONG_ANSWER
  TIME_LIMIT
  MEMORY_LIMIT
  RUNTIME_ERROR
  COMPILE_ERROR
  INTERNAL_ERROR
}

model Submission {
  id               String            @id @default(cuid())
  userId           String
  problemKey       String
  language         String
  kind             SubmissionKind
  status           SubmissionStatus  @default(QUEUED)
  verdict          SubmissionVerdict?
  code             String            @db.Text
  stdin            String?           @db.Text
  testsPassed      Int               @default(0)
  testsTotal       Int               @default(0)
  timeMs           Int?
  memoryKb         Int?
  stdoutTrunc      String?           @db.Text
  stderrTrunc      String?           @db.Text
  compileOutputTrunc String?          @db.Text
  providerRef      String?
  clientRequestId  String
  createdAt        DateTime          @default(now())
  finishedAt       DateTime?
  user             User              @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@index([userId, problemKey, createdAt])
  @@unique([userId, clientRequestId])
}
